# Enable one or more destinations. Leave unused ones blank.
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CUSTOM_WEBHOOK_URL=
# Optional: webhook consumer verifies X-Monad-Signature: sha256=<HMAC-SHA256(body)>
CUSTOM_WEBHOOK_SECRET=

# Watch every 5 minutes; valid values 60..86400 seconds
CHECK_INTERVAL_SECONDS=300
# latest: alert on latest verified announcement at first start; silent: no initial verified alerts
START_MODE=latest
